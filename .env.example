# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── LLM provider (OpenAI-compatible) ─────────────────────────────────────
# Default is OpenAI, but the interface is OpenAI-compatible so you can point
# it at DeepSeek, Qwen, OpenRouter, Together, etc. by changing the base URL
# and model. The API key is ALWAYS read from the environment — never hardcode.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# Examples for other providers (uncomment one and set LLM_API_KEY):
#   DeepSeek    LLM_BASE_URL=https://api.deepseek.com   LLM_MODEL=deepseek-coder
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct
#   Qwen        LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen2.5-coder-32b-instruct

# ─── GitHub App (separate app from Clearpath's) ───────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# ─── Razorpay (behind PaymentProvider interface) ──────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay plan IDs per paid tier (create these in the Razorpay dashboard).
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_SCALE=

# ─── Resend (transactional email) ─────────────────────────────────────────
RESEND_API_KEY=

# ─── PostHog (PLG funnel analytics) ───────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Upstash Redis + BullMQ (async test-gen / rerun queue) ────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# BullMQ needs a raw Redis TCP connection (ioredis), not just the REST API:
REDIS_URL=

# ─── Runner service (Fly.io) — optional cloud execution worker ────────────
# Verity is CI-native by default (Path B): tests run in the customer's own CI.
# This is only for the rare hosted-execution case; we never host browsers for
# paid usage, to preserve flat-pricing economics.
RUNNER_SERVICE_URL=
RUNNER_SERVICE_TOKEN=
